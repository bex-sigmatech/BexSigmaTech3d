# BEX Sigma Tech — Frontend Environment Variables
# Copy to .env and fill values

# Backend API URL (used by WebDevStore + AICore)
VITE_BACKEND_URL=http://localhost:5001
# Optional: backend host only for Gemini Live WS (fallback to bexsigmatech3d.onrender.com in prod)
VITE_BACKEND_HOST=bexsigmatech3d.onrender.com
# Cashfree env: SANDBOX or PRODUCTION — controls SDK mode (sandbox vs production)
VITE_CASHFREE_ENV=SANDBOX
