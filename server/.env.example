# BEX Sigma Tech — Server Environment Variables
# Copy to server/.env and fill values — never commit real secrets

PORT=5001
CASHFREE_APP_ID=TEST_APP_ID
CASHFREE_SECRET_KEY=TEST_SECRET_KEY
CASHFREE_ENV=SANDBOX
# Set to false in production to require real Cashfree PAID status
ALLOW_SANDBOX_AUTO_VERIFY=true

# 32+ char random string for download JWTs — REQUIRED in production
DOWNLOAD_TOKEN_SECRET=change_me_to_32_char_random_string

# Gmail App Password (or transactional provider)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Optional: restrict frontend origins (comma-separated). Leave empty to allow localhost + render host
FRONTEND_URL=http://localhost:5174,https://yourdomain.com

# Optional: protect GET /api/admin/orders — set to random bearer token
ADMIN_API_KEY=change_me_to_random_admin_token

# Per-product separate Drive links — set distinct folder/file for each product (single-use email sends only selected product's link)
DRIVE_LINK_MARKETING=https://drive.google.com/drive/folders/1GEFJyoYPuaHSpLcQFnDn4BonYtUxXQ0A?usp=drive_link
DRIVE_LINK_BUSINESS=https://drive.google.com/drive/folders/1wwLBh0BMytJc89P_BoIQkSoCZdJHB3a6?usp=drive_link
DRIVE_LINK_FINANCE=https://drive.google.com/drive/folders/REPLACE_FINANCE
DRIVE_LINK_SALES=https://drive.google.com/drive/folders/REPLACE_SALES
DRIVE_LINK_HR=https://drive.google.com/drive/folders/REPLACE_HR
DRIVE_LINK_BUNDLE=https://drive.google.com/drive/folders/18mnfnzmq6QpNV0N-QCwSYOHgdVMEOXwx
DRIVE_LINK_OMNICODER=https://drive.google.com/drive/folders/REPLACE_OMNICODER
DRIVE_LINK_QUANTUM=https://drive.google.com/drive/folders/REPLACE_QUANTUM
DRIVE_LINK_SPACEMESH=https://drive.google.com/drive/folders/REPLACE_SPACEMESH
DRIVE_LINK_VISION=https://drive.google.com/drive/folders/REPLACE_VISION
DRIVE_LINK_BIOSYNC=https://drive.google.com/drive/folders/REPLACE_BIOSYNC

# Gemini API key for Live Voice + AI chat (optional — falls back to local neural core)
GEMINI_API_KEY=your_gemini_api_key_here
